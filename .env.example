# VidMind settings. `./install.sh` (or install.ps1) writes your .env from this for you; edit it any time and restart.
# Pick ONE provider block below: put its key in, and uncomment its lines. Never commit your .env (it is git-ignored).
# A model is written "provider:model". Anything a provider has no key for is skipped, never an error.

# --- Meta Muse (default; the hackathon build). Key: https://dev.meta.ai --------------------------------------------
# One key turns on everything: Muse Spark notes, Muse Voice Transcribe, Muse Image illustrations, SAM 3.1 crops.
MODEL_API_KEY=

# --- OpenAI. Key: https://platform.openai.com/api-keys ---------------------------------------------------------------
# OPENAI_API_KEY=
# LLM_MODELS=openai:gpt-4.1-mini
# LLM_VISION_MODELS=openai:gpt-4.1-mini
# READER_MODEL=openai:gpt-4.1-mini
# SPEECH_MODEL=openai:whisper-1
# IMAGE_MODEL=openai:gpt-image-1

# --- Anthropic (Claude). Key: https://console.anthropic.com/settings/keys -------------------------------------------
# Speech is recognised on your machine (Anthropic has no speech model); no illustrations.
# ANTHROPIC_API_KEY=
# LLM_MODELS=anthropic:claude-haiku-5-5
# LLM_VISION_MODELS=anthropic:claude-haiku-5-5
# READER_MODEL=anthropic:claude-haiku-5-5

# --- Free: Groq (fastest free tier). Key: https://console.groq.com/keys ---------------------------------------------
# GROQ_API_KEY=
# LLM_MODELS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b

# --- Free: NVIDIA. Key: https://build.nvidia.com (any model page, "Get API Key") ------------------------------------
# NVIDIA_API_KEY=
# LLM_MODELS=nvidia:nvidia/nemotron-3.5-super-vl-120b-a12b
# LLM_VISION_MODELS=nvidia:nvidia/nemotron-3.5-super-vl-120b-a12b

# --- Free: OpenRouter (one key, many models; ids ending ":free" cost nothing). Key: https://openrouter.ai/keys -----
# OPENROUTER_API_KEY=
# LLM_MODELS=openrouter:meta-llama/llama-3.3-70b-instruct:free

# --- xAI Grok. Key: https://console.x.ai -------------------------------------------------------------------------------
# XAI_API_KEY=
# LLM_MODELS=xai:grok-4

# --- Ollama: free, private, on your machine. https://ollama.com -----------------------------------------------------
# No key. Needs `ollama serve` running and a model pulled: `ollama pull qwen2.5:3b` (1.9 GB; fine on 16 GB RAM).
# Tested on a 16 GB MacBook Air: first checked section in 7.8 s, a 1-minute video finished in 50 s.
# A 3B model writes notes and articles but often no takeaways; with more memory try qwen2.5:7b.
# LLM_MODELS=ollama:qwen2.5:3b

# When not on Muse, turn the Muse-only roles off so nothing waits on them (the installer does this for you):
# IMAGE_MODEL=
# SEGMENT_MODEL=
# SPEECH_MODEL=
# READER_MODEL=
# LLM_VISION_MODELS=

# --- Any other OpenAI-compatible server: name it, then use "name:model" above ----------------------------------------
# PROVIDER_TOGETHER_BASE_URL=https://api.together.xyz/v1
# PROVIDER_TOGETHER_API_KEY=
# Optional per provider: _EFFORT (reasoning_effort; empty = not sent), _MAX_IN_FLIGHT, _HEDGE_S, _KIND (muse|openai).

# --- On your machine (no key) ----------------------------------------------------------------------------------------
# Speech when no hosted speech model is set: parakeet (Apple Silicon, English, fast) or faster-whisper (any OS).
ASR_ENGINE=parakeet
WHISPER_MODEL=base
# Jobs processed at the same time.
VIDMIND_WORKERS=3
# Browser origin(s) allowed to call the API, comma-separated.
VIDMIND_WEB_ORIGIN=http://localhost:3000
